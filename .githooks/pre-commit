#!/usr/bin/env bash
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "BLOCKED: gitleaks is not installed, so secrets cannot be scanned." >&2
  exit 1
fi

# gitleaks >= 8.19 uses 'git'; older versions use 'protect'
if gitleaks git --help >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --verbose
else
  exec gitleaks protect --staged --redact --verbose
fi
